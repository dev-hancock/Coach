{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "description": "Athlete MCP Server - Docker deployment",
  "name": "io.github.dev-hancock/trainer",
  "version": "0.1.0-beta",
  "mcpServers": {
    "athlete": {
      "command": "docker",
      "args": [
        "compose",
        "run",
        "--rm",
        "athlete"
      ],
      "env": {
        "POSTGRES_USER": "athlete_user",
        "POSTGRES_PASSWORD": "athlete_password",
        "POSTGRES_DB": "athlete_db",
        "POSTGRES_HOST": "db",
        "POSTGRES_PORT": "5432"
      }
    }
  },
  "repository": {
    "url": "https://github.com/dev-hancock/trainer",
    "source": "github"
  }
}
